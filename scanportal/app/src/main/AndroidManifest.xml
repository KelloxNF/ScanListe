<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Harte Offline-Sperre: Diese Berechtigungen werden entfernt, selbst wenn eine
         Bibliothek sie beim Bauen hinzufügen wollte. Ohne INTERNET kann Android der App
         keinerlei Netzwerkzugriff erlauben. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScanListe">

        <!-- Startbildschirm mit den Kacheln „Scannen“ und „Inventur“ -->
        <activity
            android:name="de.scanportal.app.PortalActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ScanListe -->
        <activity
            android:name="de.scanliste.app.MainActivity"
            android:exported="false"
            android:label="ScanListe"
            android:parentActivityName="de.scanportal.app.PortalActivity" />
        <activity
            android:name="de.scanliste.app.ListActivity"
            android:exported="false"
            android:parentActivityName="de.scanliste.app.MainActivity"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- Inventur -->
        <activity
            android:name="de.inventur.app.MainActivity"
            android:exported="false"
            android:label="Inventur"
            android:theme="@style/Theme.Inventur"
            android:parentActivityName="de.scanportal.app.PortalActivity" />
        <activity
            android:name="de.inventur.app.EditActivity"
            android:exported="false"
            android:theme="@style/Theme.Inventur"
            android:parentActivityName="de.inventur.app.MainActivity"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity
            android:name="de.inventur.app.CountActivity"
            android:exported="false"
            android:theme="@style/Theme.Inventur"
            android:parentActivityName="de.inventur.app.MainActivity"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity
            android:name="de.inventur.app.ResultActivity"
            android:exported="false"
            android:theme="@style/Theme.Inventur"
            android:parentActivityName="de.inventur.app.CountActivity" />
        <activity
            android:name="de.inventur.app.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Inventur"
            android:parentActivityName="de.inventur.app.MainActivity"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- EmojiCompat abschalten: würde sonst beim Start über die Google-Play-Dienste
             Schriftarten aus dem Internet nachladen lassen. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
